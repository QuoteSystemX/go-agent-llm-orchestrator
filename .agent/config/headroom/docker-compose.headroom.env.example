# Headroom Tier 2 — environment variables
# Copy to .env (do not commit to git!)

# LLM Providers (at least one required)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Headroom
HEADROOM_MODE=OPTIMIZE
HEADROOM_LOG_LEVEL=INFO

# Qdrant (optional, only if semantic memory is used)
HEADROOM_QDRANT_URL=http://localhost:6333
HEADROOM_QDRANT_API_KEY=
