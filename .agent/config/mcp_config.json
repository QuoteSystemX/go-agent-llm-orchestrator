{
    "_readme": "Template config for Antigravity (Gemini). Copy to your Antigravity workspace and replace YOUR_API_KEY placeholders. The 'skills' server is required; 'context7', 'shadcn', and 'grafana' are optional extras. 'grafana' needs GRAFANA_URL and a service account token (Grafana → Administration → Service accounts) — all repositories this config is distributed to (see .github/distribution.yml) are private QuoteSystemX repos, so a real token is kept inline here rather than per-machine env vars.",
    "mcpServers": {
        "codebase-memory": {
            "command": ".agent/scripts/delivery/codebase-memory-mcp.sh",
            "env": {
                "CODEBASE_MEMORY_DB_DIR": "${workspaceFolder}/.codebase-memory",
                "CODEBASE_MEMORY_EXCLUDE": "node_modules,.git,.gemini,dist"
            }
        },
        "mcp-llm-broker": {
            "command": ".agent/mcp-llm-broker/mcp-llm-broker.sh",
            "args": ["--http-port", "11436"]
        },
        "local-skill-server": {
            "command": "/usr/bin/env",
            "args": ["agent-kit-server"]
        },
        "shadcn": {
            "command": "npx",
            "args": [
                "shadcn@latest",
                "mcp"
            ]
        },
        "context7": {
            "command": "npx",
            "args": [
                "-y",
                "@upstash/context7-mcp"
            ]
        },
        "wikipedia": {
            "command": "npx",
            "args": [
                "-y",
                "wikipedia-mcp"
            ]
        },
        "filesystem": {
            "command": ".agent/scripts/delivery/filesystem-mcp.sh"
        },
        "github": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-github"
            ]
        },
        "browser": {
            "command": "npx",
            "args": [
                "-y",
                "@modelcontextprotocol/server-puppeteer"
            ]
        },
        "grafana": {
            "command": ".agent/scripts/delivery/grafana-mcp.sh",
            "env": {
                "GRAFANA_URL": "http://grafana.lab.me/",
                "GRAFANA_SERVICE_ACCOUNT_TOKEN": "glsa_m17fFU5mGDiffQ0tKwlGy5CoLkgiF25t_97e4ec3d"
            }
        }
    }
}