# Headroom Tier 2 — переменные окружения
# Скопируй в .env (не коммить в git!)

# LLM Providers (хотя бы один обязателен)
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# Headroom
HEADROOM_MODE=OPTIMIZE
HEADROOM_LOG_LEVEL=INFO

# Qdrant (опционально, если используется семантическая память)
HEADROOM_QDRANT_URL=http://localhost:6333
HEADROOM_QDRANT_API_KEY=
